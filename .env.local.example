# Copy to .env.local and fill in. NEVER commit .env.local itself.

# Supabase (Settings -> API in your project dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: Whop monetization (leave commented until you have a product) ---
# WHOP_API_KEY=whop_...
# WHOP_PRODUCT_ID=prod_...
# NEXT_PUBLIC_WHOP_CHECKOUT_FAMILY=https://whop.com/checkout/...
# NEXT_PUBLIC_WHOP_CHECKOUT_PRO=https://whop.com/checkout/...
# NEXT_PUBLIC_WHOP_CHECKOUT_AGENCY=https://whop.com/checkout/...
